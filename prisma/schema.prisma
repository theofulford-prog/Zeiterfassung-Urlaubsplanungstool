generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  name                String
  email               String         @unique
  passwordHash        String
  /// "ADMIN" | "GF" | "LEAD" | "EMPLOYEE" – Rechte siehe src/lib/permissions.ts
  role                String         @default("EMPLOYEE")
  /// Interner Kostensatz in EUR pro Stunde – nur für die Geschäftsführung sichtbar
  hourlyCost          Float          @default(0)
  weeklyHours         Float          @default(40)
  /// false z. B. für Gesellschafter:innen ohne Zeiterfassung – erscheinen dann nicht in Auslastung/Hinweisen
  tracksTime          Boolean        @default(true)
  vacationDaysPerYear Int            @default(30)
  /// Resturlaub aus dem Vorjahr, gilt für carryoverYear
  carryoverDays       Float          @default(0)
  carryoverYear       Int?
  active              Boolean        @default(true)
  /// Erster Arbeitstag (YYYY-MM-DD); ab hier zählt das Soll. Leer = Anlagedatum
  entryDate           String?
  /// Letzter Arbeitstag (YYYY-MM-DD); danach kein Login mehr, kein Soll, nicht mehr in Auswertungen
  exitDate            String?
  /// Gesetzt, wenn die Person anonymisiert wurde (Name/E-Mail entfernt, Stunden bleiben erhalten)
  anonymizedAt        DateTime?
  /// Wird bei Passwortänderung erhöht und macht alte Sitzungen ungültig
  sessionVersion      Int            @default(0)
  /// Zeitpunkt, an dem die Person ihr Passwort gesetzt hat (null = Einladung noch nicht angenommen)
  passwordSetAt       DateTime?
  /// Start-/Übergangspasswort: muss beim nächsten Login geändert werden
  mustChangePassword  Boolean        @default(false)
  createdAt           DateTime       @default(now())
  timeEntries         TimeEntry[]
  workDays            WorkDay[]
  authTokens          AuthToken[]
  leaveRequests       LeaveRequest[] @relation("requester")
  decisions           LeaveRequest[] @relation("decider")
}

model Project {
  id          String      @id @default(cuid())
  name        String
  /// z.B. "Renovierung", "Verwaltung", "Akquise", "Intern"
  category    String
  description String?
  /// Optionales Budget für Personalkosten in EUR
  budget      Float?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  timeEntries TimeEntry[]
}

model TimeEntry {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  /// Kalendertag im Format YYYY-MM-DD
  date      String
  hours     Float
  note      String?
  /// Kostensatz der Person zum Zeitpunkt der Buchung (EUR/h)
  costRate  Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([projectId, date])
}

model LeaveRequest {
  id           String   @id @default(cuid())
  userId       String
  /// YYYY-MM-DD, jeweils inklusive
  startDate    String
  endDate      String
  /// "VACATION" | "SICK" | "OTHER"
  type         String   @default("VACATION")
  /// "PENDING" | "APPROVED" | "REJECTED"
  status       String   @default("PENDING")
  /// Arbeitstage (ohne Wochenenden und Feiertage); 0,5 bei halbem Tag
  days         Float
  halfDay      Boolean  @default(false)
  note         String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation("requester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy    User?    @relation("decider", fields: [decidedById], references: [id])

  @@index([startDate, endDate])
}

/// Gesetzliche Arbeitszeiterfassung: Beginn, Ende und Pause pro Tag
model WorkDay {
  id           String   @id @default(cuid())
  userId       String
  /// YYYY-MM-DD
  date         String
  /// "HH:MM"
  start        String
  end          String
  breakMinutes Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/// Einmal-Links für Einladung und Passwort-Zurücksetzen. Gespeichert wird nur der Hash des Tokens.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  /// "INVITE" | "RESET"
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Rechte je Rolle (bearbeitbar unter "Rollen & Rechte"). Leer = Standardrechte aus src/lib/permissions.ts.
model RolePermission {
  role        String
  permission  String
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@id([role, permission])
}
