# Lokal: eingebautes PostgreSQL (npm run dev bzw. npm run db:start).
# Azure: postgresql://<user>:<passwort>@<server>.postgres.database.azure.com:5432/teamzeit?sslmode=require
DATABASE_URL="postgresql://teamzeit:teamzeit@localhost:5433/teamzeit"
# Langer zufälliger Wert, z.B. mit: openssl rand -base64 32
AUTH_SECRET="bitte-ersetzen"
# Erste Admin-Konten (werden beim Start angelegt, falls nicht vorhanden): "mail:Name,mail:Name"
INITIAL_ADMINS="vorname@firma.de:Vorname Nachname"
# Erste Konten der Geschäftsführung (optional), gleiches Format
INITIAL_GF=""
# Startpasswort für diese Konten – muss beim ersten Login geändert werden
INITIAL_ADMIN_PASSWORD="bitte-ersetzen"
# Öffentliche Adresse der App (für Einladungslinks), lokal leer lassen
APP_URL=""
# Schlüssel für verschlüsselte Lohndaten (Steuer-ID, SV-Nummer, IBAN) – 32 Byte base64, z.B.: openssl rand -base64 32
# Nie ändern, solange verschlüsselte Daten existieren; getrennt von der Datenbank aufbewahren.
PII_ENCRYPTION_KEY="bitte-ersetzen"
