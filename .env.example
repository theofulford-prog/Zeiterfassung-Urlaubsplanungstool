# Lokal: SQLite-Datei im prisma-Ordner. Auf Azure App Service z.B. file:/home/data/teamzeit.db
DATABASE_URL="file:./dev.db"
# Langer zufälliger Wert, z.B. mit: openssl rand -base64 32
AUTH_SECRET="bitte-ersetzen"
# Erste Admin-Konten (werden beim Start angelegt, falls nicht vorhanden): "mail:Name,mail:Name"
INITIAL_ADMINS="vorname@firma.de:Vorname Nachname"
# Erste Konten der Geschäftsführung (optional), gleiches Format
INITIAL_GF=""
# Startpasswort für diese Konten – muss beim ersten Login geändert werden
INITIAL_ADMIN_PASSWORD="bitte-ersetzen"
# Öffentliche Adresse der App (für Einladungslinks), lokal leer lassen
APP_URL=""
